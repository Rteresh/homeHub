# Настройки для scripts/*.sh на сервере (SSH). Не используется Docker-контейнерами.
# Скопируйте: cp .env.host.example .env.host
#
# Скрипты загружают сначала .env (секреты и общие параметры), затем .env.host (переопределения).

HOMEHUB_STORAGE_ROOT=/srv/storage/homehub
PROJECT_NAME=homehub

# Для backup-db.sh можно переопределить каталог дампов:
# BACKUP_DIR=/srv/storage/homehub/backup/db-dumps

# Если pg_dump без docker compose — хост PostgreSQL на машине
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
